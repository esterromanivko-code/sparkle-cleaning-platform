# ─── SERVER ───────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── PERSISTENT STORAGE ────────────────────────────
# CRITICAL IN PRODUCTION. Container filesystems are wiped on every deploy, so
# these must point at a mounted Volume or the database and all uploaded
# documents are destroyed each time you push.
#
# Railway: Settings -> Volumes -> New Volume, mount path /data. Then set:
#   DB_PATH=/data/sparkle.db
#   UPLOAD_DIR=/data/uploads
#   BACKUP_DIR=/data/backups
#
# Left unset, they default to paths inside the app directory. That is fine for
# local development; the server refuses to boot with NODE_ENV=production unless
# they point outside the app dir (override with ALLOW_EPHEMERAL_STORAGE=true).
# DB_PATH=/data/sparkle.db
# UPLOAD_DIR=/data/uploads
# BACKUP_DIR=/data/backups

# ─── SECURITY ──────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_min_64_chars
JWT_EXPIRES_IN=7d

# ─── STRIPE ────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX
STRIPE_BG_CHECK_PRICE=3000          # $30.00 in cents
STRIPE_PRO_MONTHLY_PRICE=1800       # $18.00 in cents
STRIPE_PRO_ANNUAL_PRICE=18000       # $180.00 in cents
STRIPE_GUARANTEE_PRICE=1200         # $12.00 in cents
STRIPE_PRIORITY_PRICE=700           # $7.00 in cents

# ─── CHECKR (Background checks) ────────────────────
# Sign up at https://checkr.com → get API key from dashboard
CHECKR_API_KEY=your_checkr_api_key_here
CHECKR_PACKAGE=tasker_standard       # or pro_criminal, driver_pro etc.
CHECKR_WEBHOOK_SECRET=your_checkr_webhook_secret

# ─── STRIPE IDENTITY (ID Verification) ─────────────
# Already included in your Stripe account - just enable it
STRIPE_IDENTITY_ENABLED=true

# ─── EMAIL (Nodemailer) ─────────────────────────────
# Use Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Sparkle <hello@sparkle.com>

# ─── CAPTCHA (Cloudflare Turnstile) ────────────────
# Protects register / login / forgot-password from bot signups.
#
# Setup: dash.cloudflare.com → Turnstile → Add Site
#   Widget mode: Invisible
#   Hostnames:   your Netlify domain (add "localhost" too for local testing)
#
# SET BOTH OR NEITHER. With a secret key present the backend starts REQUIRING a
# token; the frontend only sends one when it can read a site key from
# GET /api/config. Setting just the secret would reject every login and signup.
# Leave both unset and CAPTCHA is skipped entirely (bot protection off).
#
# The site key is public by design — it is served to the browser. Only the
# secret key must stay private.
#
# Cloudflare's own dummy keys, handy for testing the wiring end to end:
#   always passes: site 1x00000000000000000000BB / secret 1x0000000000000000000000000000000AA
#   always fails:  site 1x00000000000000000000BB / secret 2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ─── FRONTEND ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── PLATFORM FEES ─────────────────────────────────
PLATFORM_FEE_PERCENT=8              # 8% from regular clients (covers Stripe ~3% + real margin)
BUSINESS_FEE_PERCENT=10            # 10% from business/property manager accounts
TIP_FEE_PERCENT=1.5                # 1.5% on tips
INSTANT_CASHOUT_FEE=10.00          # $10 flat fee for instant payout (minutes)
STANDARD_CASHOUT_FEE=0             # Free for weekly scheduled payouts
BG_CHECK_PRICE=30.00               # Cleaner pays $30 (covers costs + ~$10.50 margin) ($40 - $19.50 costs = ~$20.50 profit per check)
